package render

import "core:crypto/hash"
import "core:encoding/hex"
import "core:fmt"
import "core:mem"
import "vendor:directx/d3d11"

// The shaders are written once, in WGSL (render/*.wgsl): the WebGPU backend compiles them as they are (wgpu / naga), the Direct3D 11
// backend uses the HLSL that naga writes from them (render/shaders/*.hlsl, generated: tools/wgsl2hlsl, naga pinned exactly and by
// Cargo.lock) compiled ahead of time to DXBC (render/shaders/*.dxbc) and embedded: compiling the shaders when the renderer starts took
// about 280 ms of every launch. `odin run tools/shaders` writes the HLSL and the blobs from the WGSL; tests/shaders fails when a
// WGSL source changed and the HLSL (its header names the SHA-256 of the sources it came from) or a blob was not written again.
// -define:RENDER_COMPILE_SHADERS=true compiles the generated HLSL at start-up instead (while experimenting with the compiler flags).

RENDER_COMPILE_SHADERS :: #config(RENDER_COMPILE_SHADERS, false)

WGSL_RECT :: #load("rect.wgsl", string)
WGSL_FILTER :: #load("filter.wgsl", string)
WGSL_SLUG :: #load("slug.wgsl", string)
WGSL_MIP :: #load("mip.wgsl", string)   // WebGPU only: Direct3D 11 has GenerateMips

// The Direct3D 11 slots of the resources of the WGSL (group.binding = register): what naga is told when it writes the HLSL, and what
// the backend binds (bind_main, run_pass, slug_bind_inputs). Samplers: s0 atlas (bilinear), s1 images (trilinear), s2 tiled images.
RECT_BINDINGS :: []string{
	"0.0=b0", "0.1=b2", "0.2=t2", "0.3=t3", "0.4=t4", "0.5=t6", "0.6=t7", "0.7=t8", "0.8=t9", "0.9=t10",
	"0.10=s0", "0.11=s1", "0.12=s2", "1.0=t0", "1.1=t1", "1.2=t5",
}
SLUG_BINDINGS :: []string{
	"0.0=b0", "0.1=b2", "0.2=t2", "0.3=t3", "0.4=t4", "0.5=t6", "0.6=t7", "0.7=t8", "0.8=t9", "0.9=t10",
	"0.10=s0", "0.11=s1", "0.12=s2", "1.0=t0", "1.1=t1", "1.2=t5", "1.3=t11", "1.4=t12",
}
FILTER_BINDINGS :: []string{"0.0=b1", "0.1=t0", "0.2=t1", "0.3=s0"}

NAGA_VERSION :: "29.0.4"

// A shader module: the WGSL files that make it (concatenated, in order, a newline after each) and the HLSL written from them.
Shader_Module :: enum u8 { Rect, Filter, Slug }

Module_Desc :: struct {
	file:       string,     // render/shaders/<file>: the generated HLSL
	wgsl_files: []string,   // render/<name>: the sources
	wgsl:       []string,
	bindings:   []string,
	hlsl:       string,     // the HLSL that is embedded
}

MODULES := [Shader_Module]Module_Desc{
	.Rect   = {"rect.hlsl", {"rect.wgsl"}, {WGSL_RECT}, RECT_BINDINGS, #load("shaders/rect.hlsl", string)},
	.Filter = {"filter.hlsl", {"filter.wgsl"}, {WGSL_FILTER}, FILTER_BINDINGS, #load("shaders/filter.hlsl", string)},
	// the Slug text shaders use the helpers of rect.wgsl (transforms, clips, text correction): one module, rect.wgsl first
	.Slug   = {"slug.hlsl", {"rect.wgsl", "slug.wgsl"}, {WGSL_RECT, WGSL_SLUG}, SLUG_BINDINGS, #load("shaders/slug.hlsl", string)},
}

// The WGSL of a module as naga reads it (and as the SHA-256 below is taken).
module_source :: proc(m: Shader_Module, allocator := context.allocator) -> string {
	b := make([dynamic]u8, allocator)
	for s in MODULES[m].wgsl {
		append(&b, s)
		append(&b, '\n')
	}
	return string(b[:])
}

// The SHA-256 of the sources of a module, in hex.
module_hash :: proc(m: Shader_Module, allocator := context.allocator) -> string {
	src := module_source(m, context.temp_allocator)
	digest := hash.hash_string(.SHA256, src, context.temp_allocator)
	return string(hex.encode(digest, allocator))
}

// The first line of a generated HLSL file.
module_header :: proc(m: Shader_Module, allocator := context.allocator) -> string {
	return fmt.aprintf("// Generated by tools/shaders (naga %s) from %v: sha256 %s. Do not edit.\n", NAGA_VERSION, MODULES[m].wgsl_files, module_hash(m, context.temp_allocator), allocator = allocator)
}

Shader_Id :: enum u8 {
	Rect_VS,
	Rect_PS,
	Filter_VS,
	Filter_PS,
	Slug_VS,
	Slug_PS,
}

Shader_Desc :: struct {
	module: Shader_Module,
	name:   cstring,   // the file name the compiler reports errors against
	entry:  cstring,
	target: cstring,
	file:   string,    // render/shaders/<file>: the compiled blob
	blob:   []u8,      // what was compiled ahead of time
}

SHADERS := [Shader_Id]Shader_Desc{
	.Rect_VS   = {.Rect, "rect.hlsl", "vs_main", "vs_5_0", "rect_vs.dxbc", #load("shaders/rect_vs.dxbc")},
	.Rect_PS   = {.Rect, "rect.hlsl", "ps_main", "ps_5_0", "rect_ps.dxbc", #load("shaders/rect_ps.dxbc")},
	.Filter_VS = {.Filter, "filter.hlsl", "vs_fx", "vs_5_0", "filter_vs.dxbc", #load("shaders/filter_vs.dxbc")},
	.Filter_PS = {.Filter, "filter.hlsl", "ps_fx", "ps_5_0", "filter_ps.dxbc", #load("shaders/filter_ps.dxbc")},
	.Slug_VS   = {.Slug, "slug.hlsl", "vs_slug", "vs_5_0", "slug_vs.dxbc", #load("shaders/slug_vs.dxbc")},
	.Slug_PS   = {.Slug, "slug.hlsl", "ps_slug", "ps_5_0", "slug_ps.dxbc", #load("shaders/slug_ps.dxbc")},
}

// Compiles HLSL text (tools/shaders for the HLSL it just wrote, tests/shaders). The bytes are a copy in `allocator`.
compile_hlsl :: proc(source: string, id: Shader_Id, allocator := context.allocator) -> (code: []u8, ok: bool) {
	d := SHADERS[id]
	blob := compile(source, d.entry, d.target, d.name) or_return
	defer blob->Release()
	src := mem.slice_ptr(cast([^]u8)blob->GetBufferPointer(), int(blob->GetBufferSize()))
	code = make([]u8, len(src), allocator)
	copy(code, src)
	return code, true
}

// Compiles a shader from the embedded HLSL (tests/shaders).
shader_compile :: proc(id: Shader_Id, allocator := context.allocator) -> (code: []u8, ok: bool) {
	return compile_hlsl(MODULES[SHADERS[id].module].hlsl, id, allocator)
}

// The code of a shader for the device: the embedded blob, or the HLSL compiled now (RENDER_COMPILE_SHADERS).
// Release the blob with shader_code_done.
@(private)
shader_code :: proc(id: Shader_Id) -> (code: []u8, blob: ^d3d11.IBlob, ok: bool) {
	when RENDER_COMPILE_SHADERS {
		d := SHADERS[id]
		blob = compile(MODULES[d.module].hlsl, d.entry, d.target, d.name) or_return
		return mem.slice_ptr(cast([^]u8)blob->GetBufferPointer(), int(blob->GetBufferSize())), blob, true
	} else {
		code = SHADERS[id].blob
		return code, nil, len(code) > 0
	}
}

@(private)
shader_code_done :: proc(blob: ^d3d11.IBlob) {
	if blob != nil { blob->Release() }
}
