// The licence Worker of papier, made by `licence worker` from its licence.Product: make it again rather than
// edit the product's values. SET: what the maintainer still sets (licence-worker/README.md). No secret is here.
{
	"name": "papier-licence",
	"main": "../src/index.ts",
	"compatibility_date": "2026-10-01",
	"workers_dev": true,
	"observability": { "enabled": true },
	"kv_namespaces": [{ "binding": "LICENSES" }],
	"durable_objects": { "bindings": [{ "name": "ORDERS", "class_name": "LicenseOrder" }] },
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["LicenseOrder"] }],
	"send_email": [{ "name": "EMAIL" }],

	"vars": {
		"PRODUCT": "papier",
		"PRODUCT_TITLE": "papier",
		"VERSION_TAG": "PAPIER1",
		"SIGN_CONTEXT": "papier-licence-v1\n",
		"FILE_EXTENSION": ".papierlicence",
		"ORDER_PREFIX": "PAPIER",
		"EDITIONS": "[{\"id\":\"supporter\",\"title\":\"Supporter\"}]",
		"UPDATE_YEARS": "",
		"UPDATES_FROM": "",
		"LICENSE_PUBLIC_KEY": "s67_MOVX2AnUb4R11Q8IgT1JtLa9F3POujv3fwwSvGQ",
		"PRICES": "{\"pri_01m7fyah37tdgnpsxs8kh5ss03\":\"supporter\"}",
		"PADDLE_API_BASE": "https://api.paddle.com",
		"ALLOWED_ORIGIN": "https://papier.froment.software",
		"MAIL_FROM": "papier <license@mail.froment.software>",
		"MAIL_REPLY_TO": "",
		"MAIL_SUBJECT": "",
		"MAIL_TEXT": "",
		"FILE_HINT": "Open this file with papier (Settings > General > Choose a file), or paste the key there.",
		"WEBHOOK_TOLERANCE_SECONDS": "300",
		"RESEND_ENABLED": "false",
		"RESEND_MAX_PER_HOUR": "3",
		"RESEND_REQUIRE_TOKEN": "false",
		"MAIL_BACKOFF_MINUTES": "1,5,30,120,720,2880",
		"MAIL_MAX_ATTEMPTS": "7",
		"PII_RETENTION_DAYS": "90"
	},

	"env": {
		"sandbox": {
			"name": "papier-licence-sandbox",
			"workers_dev": true,
			"observability": { "enabled": true },
			"kv_namespaces": [{ "binding": "LICENSES" }],
			"durable_objects": { "bindings": [{ "name": "ORDERS", "class_name": "LicenseOrder" }] },
			"migrations": [{ "tag": "v1", "new_sqlite_classes": ["LicenseOrder"] }],
			"send_email": [{ "name": "EMAIL" }],
			"vars": {
				"PRODUCT": "papier",
				"PRODUCT_TITLE": "papier",
				"VERSION_TAG": "PAPIER1",
				"SIGN_CONTEXT": "papier-licence-v1\n",
				"FILE_EXTENSION": ".papierlicence",
				"ORDER_PREFIX": "PAPIER",
				"EDITIONS": "[{\"id\":\"supporter\",\"title\":\"Supporter\"}]",
				"UPDATE_YEARS": "",
				"UPDATES_FROM": "",
				"LICENSE_PUBLIC_KEY": "AxUmDVadQ3OHFyeMIrDczTTo63rdjtn3zgMJ6a6QyU0",
				"PRICES": "{}",   // SET: the sandbox's price ids (`paddle -apply`)
				"PADDLE_API_BASE": "https://sandbox-api.paddle.com",
				"ALLOWED_ORIGIN": "https://papier.froment.software,http://localhost:8765",
				"MAIL_FROM": "papier <license@mail.froment.software>",
				"MAIL_REPLY_TO": "",
				"MAIL_SUBJECT": "",
				"MAIL_TEXT": "",
				"FILE_HINT": "Open this file with papier (Settings > General > Choose a file), or paste the key there.",
				"WEBHOOK_TOLERANCE_SECONDS": "300",
				"RESEND_ENABLED": "false",
				"RESEND_MAX_PER_HOUR": "3",
				"RESEND_REQUIRE_TOKEN": "false",
				"MAIL_BACKOFF_MINUTES": "1,5,30,120,720,2880",
				"MAIL_MAX_ATTEMPTS": "7",
				"PII_RETENTION_DAYS": "90"
			}
		}
	}
}
