// The licence Worker of classeur, made by `licence worker` from its licence.Product: make it again rather than
// edit the product's values. SET: what the maintainer still sets (licence-worker/README.md). No secret is here.
{
	"name": "classeur-licence",
	"main": "../src/index.ts",
	"compatibility_date": "2026-10-01",
	"workers_dev": true,
	"observability": { "enabled": true },
	"kv_namespaces": [{ "binding": "LICENSES" }],
	"durable_objects": { "bindings": [{ "name": "ORDERS", "class_name": "LicenseOrder" }] },
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["LicenseOrder"] }],
	"send_email": [{ "name": "EMAIL" }],

	"vars": {
		"PRODUCT": "classeur",
		"PRODUCT_TITLE": "classeur",
		"VERSION_TAG": "CLASSEUR1",
		"SIGN_CONTEXT": "classeur-licence-v1\n",
		"FILE_EXTENSION": ".classeurlicence",
		"ORDER_PREFIX": "CLASSEUR",
		"EDITIONS": "[{\"id\":\"supporter\",\"title\":\"Supporter\"}]",
		"UPDATE_YEARS": "",
		"UPDATES_FROM": "",
		"LICENSE_PUBLIC_KEY": "3q6lBp_XhL7hHNdoBfy5zgwmwqaI-xtls_M9DImZnSw",
		"PRICES": "{}",   // SET: {"pri_...":"<edition>"}, what `paddle -apply` prints
		"PADDLE_API_BASE": "https://api.paddle.com",
		"ALLOWED_ORIGIN": "https://classeur.froment.software",
		"MAIL_FROM": "classeur <license@mail.froment.software>",
		"MAIL_REPLY_TO": "",
		"MAIL_SUBJECT": "",
		"MAIL_TEXT": "",
		"FILE_HINT": "Open this file with classeur (Settings > General > Licence > Choose a file), or paste the key there.",
		"WEBHOOK_TOLERANCE_SECONDS": "300",
		"RESEND_ENABLED": "false",
		"RESEND_MAX_PER_HOUR": "3",
		"RESEND_REQUIRE_TOKEN": "false",
		"MAIL_BACKOFF_MINUTES": "1,5,30,120,720,2880",
		"MAIL_MAX_ATTEMPTS": "7",
		"PII_RETENTION_DAYS": "90"
	},

	"env": {
		"sandbox": {
			"name": "classeur-licence-sandbox",
			"workers_dev": true,
			"observability": { "enabled": true },
			"kv_namespaces": [{ "binding": "LICENSES" }],
			"durable_objects": { "bindings": [{ "name": "ORDERS", "class_name": "LicenseOrder" }] },
			"migrations": [{ "tag": "v1", "new_sqlite_classes": ["LicenseOrder"] }],
			"send_email": [{ "name": "EMAIL" }],
			"vars": {
				"PRODUCT": "classeur",
				"PRODUCT_TITLE": "classeur",
				"VERSION_TAG": "CLASSEUR1",
				"SIGN_CONTEXT": "classeur-licence-v1\n",
				"FILE_EXTENSION": ".classeurlicence",
				"ORDER_PREFIX": "CLASSEUR",
				"EDITIONS": "[{\"id\":\"supporter\",\"title\":\"Supporter\"}]",
				"UPDATE_YEARS": "",
				"UPDATES_FROM": "",
				"LICENSE_PUBLIC_KEY": "E2W_yH5ujOtduTE-7wHGjNJbbf7XVqi5MGi20IJA5nQ",
				"PRICES": "{}",   // SET: {"pri_...":"<edition>"}, what `paddle -apply` prints
				"PADDLE_API_BASE": "https://sandbox-api.paddle.com",
				"ALLOWED_ORIGIN": "https://classeur.froment.software,http://localhost:8765",
				"MAIL_FROM": "classeur <license@mail.froment.software>",
				"MAIL_REPLY_TO": "",
				"MAIL_SUBJECT": "",
				"MAIL_TEXT": "",
				"FILE_HINT": "Open this file with classeur (Settings > General > Licence > Choose a file), or paste the key there.",
				"WEBHOOK_TOLERANCE_SECONDS": "300",
				"RESEND_ENABLED": "false",
				"RESEND_MAX_PER_HOUR": "3",
				"RESEND_REQUIRE_TOKEN": "false",
				"MAIL_BACKOFF_MINUTES": "1,5,30,120,720,2880",
				"MAIL_MAX_ATTEMPTS": "7",
				"PII_RETENTION_DAYS": "90"
			}
		}
	}
}
