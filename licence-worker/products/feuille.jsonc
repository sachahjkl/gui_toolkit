// The licence Worker of Feuille, made by `licence worker` from its licence.Product: make it again rather than
// edit the product's values. SET: what the maintainer still sets (licence-worker/README.md). No secret is here.
{
	"name": "feuille-licence",
	"main": "../src/index.ts",
	"compatibility_date": "2026-10-01",
	"workers_dev": true,
	"observability": { "enabled": true },
	"kv_namespaces": [{ "binding": "LICENSES" }],
	"durable_objects": { "bindings": [{ "name": "ORDERS", "class_name": "LicenseOrder" }] },
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["LicenseOrder"] }],
	"send_email": [{ "name": "EMAIL" }],

	"vars": {
		"PRODUCT": "feuille",
		"PRODUCT_TITLE": "Feuille",
		"VERSION_TAG": "FEUILLE1",
		"SIGN_CONTEXT": "feuille-licence-v1\n",
		"FILE_EXTENSION": ".feuillelicence",
		"ORDER_PREFIX": "FEUILLE",
		"EDITIONS": "[{\"id\":\"supporter\",\"title\":\"Supporter\"}]",
		"UPDATE_YEARS": "",
		"UPDATES_FROM": "",
		"LICENSE_PUBLIC_KEY": "_OynJxGLRyyW2_FWoj1mQtlDkO83UY8wF1TvJBGwL_0",
		"PRICES": "{\"pri_01m7mjektq8b49e041ppps7tv3\":\"supporter\"}",
		"PADDLE_API_BASE": "https://api.paddle.com",
		"ALLOWED_ORIGIN": "https://feuille.froment.software",
		"MAIL_FROM": "feuille <license@mail.froment.software>",
		"MAIL_REPLY_TO": "",
		"MAIL_SUBJECT": "",
		"MAIL_TEXT": "",
		"FILE_HINT": "Open this file with Feuille (Settings > General > Licence, Choose a file), or paste the key there.",
		"WEBHOOK_TOLERANCE_SECONDS": "300",
		"RESEND_ENABLED": "false",
		"RESEND_MAX_PER_HOUR": "3",
		"RESEND_REQUIRE_TOKEN": "false",
		"MAIL_BACKOFF_MINUTES": "1,5,30,120,720,2880",
		"MAIL_MAX_ATTEMPTS": "7",
		"PII_RETENTION_DAYS": "90"
	},

	"env": {
		"sandbox": {
			"name": "feuille-licence-sandbox",
			"workers_dev": true,
			"observability": { "enabled": true },
			"kv_namespaces": [{ "binding": "LICENSES" }],
			"durable_objects": { "bindings": [{ "name": "ORDERS", "class_name": "LicenseOrder" }] },
			"migrations": [{ "tag": "v1", "new_sqlite_classes": ["LicenseOrder"] }],
			"send_email": [{ "name": "EMAIL" }],
			"vars": {
				"PRODUCT": "feuille",
				"PRODUCT_TITLE": "Feuille",
				"VERSION_TAG": "FEUILLE1",
				"SIGN_CONTEXT": "feuille-licence-v1\n",
				"FILE_EXTENSION": ".feuillelicence",
				"ORDER_PREFIX": "FEUILLE",
				"EDITIONS": "[{\"id\":\"supporter\",\"title\":\"Supporter\"}]",
				"UPDATE_YEARS": "",
				"UPDATES_FROM": "",
				"LICENSE_PUBLIC_KEY": "mA6MWGlLlsRDP5CHEp-GZ-zG15M13teRS4g7Vb48Z2I",
				"PRICES": "{}",   // SET: {"pri_...":"<edition>"}, what `paddle -apply` prints
				"PADDLE_API_BASE": "https://sandbox-api.paddle.com",
				"ALLOWED_ORIGIN": "https://feuille.froment.software,http://localhost:8765",
				"MAIL_FROM": "feuille <license@mail.froment.software>",
				"MAIL_REPLY_TO": "",
				"MAIL_SUBJECT": "",
				"MAIL_TEXT": "",
				"FILE_HINT": "Open this file with Feuille (Settings > General > Licence, Choose a file), or paste the key there.",
				"WEBHOOK_TOLERANCE_SECONDS": "300",
				"RESEND_ENABLED": "false",
				"RESEND_MAX_PER_HOUR": "3",
				"RESEND_REQUIRE_TOKEN": "false",
				"MAIL_BACKOFF_MINUTES": "1,5,30,120,720,2880",
				"MAIL_MAX_ATTEMPTS": "7",
				"PII_RETENTION_DAYS": "90"
			}
		}
	}
}
