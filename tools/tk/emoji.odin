// Unicode's emoji data made into font/emoji_data.odin, and the conformance board of the COLR interpreter against Edge.
package tk

import "core:fmt"
import "core:os"
import "core:path/filepath"
import "core:slice"
import "core:strconv"
import "core:strings"
import "core:time"

EMOJI_DATA_SOURCE :: "font/emoji_data.odin"
// A line of ranges in it, at most (with its tab).
EMOJI_DATA_LINE :: 118

Emoji_Data :: struct {
	source:                string,   // the Odin file
	version:               string,   // of Unicode, as emoji-data.txt says it
	emoji, presentation:   int,      // the ranges of each property, before neighbours are merged
}

Range :: [2]rune

// font/emoji_data.odin from the text of emoji-data.txt: the Emoji and Emoji_Presentation properties as sorted ranges.
emoji_data_source :: proc(text: string) -> (d: Emoji_Data) {
	emoji := make([dynamic]Range, context.temp_allocator)
	presentation := make([dynamic]Range, context.temp_allocator)
	for line in strings.split_lines(text, context.temp_allocator) {
		l := strings.trim_right(line, "\r")
		if d.version == "" && strings.has_prefix(strings.to_lower(l, context.temp_allocator), "# version") {
			digits := make([dynamic]byte, context.temp_allocator)
			for c in transmute([]byte)l { if (c >= '0' && c <= '9') || c == '.' { append(&digits, c) } }
			d.version = string(digits[:])
		}
		r, property, ok := data_line(l)
		if !ok { continue }
		switch property {
		case "Emoji": append(&emoji, r)
		case "Emoji_Presentation": append(&presentation, r)
		}
	}
	d.emoji, d.presentation = len(emoji), len(presentation)
	b := strings.builder_make(context.temp_allocator)
	fmt.sbprintf(&b, "package font\n\n// Generated by tools/tk gen_emoji_data from Unicode %s emoji-data.txt (the file tools/tk fetch_emoji -unicode pins). Do not edit.\n\n", d.version)
	strings.write_string(&b, "// Emoji=Yes: characters that have an emoji presentation (with U+FE0F, or by default).\n")
	write_ranges(&b, "EMOJI_RANGES", emoji[:])
	strings.write_string(&b, "\n// Emoji_Presentation=Yes: characters drawn as emoji unless U+FE0E follows.\n")
	write_ranges(&b, "EMOJI_PRESENTATION_RANGES", presentation[:])
	d.source = strings.to_string(b)
	return
}

// A line `<first>[..<last>] ; <property> # ...` of emoji-data.txt (hexadecimal digits of either case).
data_line :: proc(l: string) -> (r: Range, property: string, ok: bool) {
	hex_end :: proc(s: string, from: int) -> int {
		i := from
		for i < len(s) && strings.index_byte("0123456789abcdefABCDEF", s[i]) >= 0 { i += 1 }
		return i
	}
	is_space :: proc(c: byte) -> bool { return c == ' ' || c == '\t' || c == '\v' || c == '\f' }
	is_word :: proc(c: byte) -> bool { return c == '_' || (c >= '0' && c <= '9') || (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') }
	i := hex_end(l, 0)
	if i == 0 { return }
	first, _ := strconv.parse_int(l[:i], 16)
	last := first
	if strings.has_prefix(l[i:], "..") {
		j := hex_end(l, i + 2)
		if j == i + 2 { return }
		last, _ = strconv.parse_int(l[i + 2:j], 16)
		i = j
	}
	for i < len(l) && is_space(l[i]) { i += 1 }
	if i >= len(l) || l[i] != ';' { return }
	i += 1
	for i < len(l) && is_space(l[i]) { i += 1 }
	start := i
	for i < len(l) && is_word(l[i]) { i += 1 }
	if i == start { return }
	property = l[start:i]
	for i < len(l) && is_space(l[i]) { i += 1 }
	if i >= len(l) || l[i] != '#' { return }
	return {rune(first), rune(last)}, property, true
}

// `@(rodata) NAME := [?][2]rune{...}`: the ranges sorted, neighbours and overlaps merged.
write_ranges :: proc(b: ^strings.Builder, name: string, ranges: []Range) {
	slice.stable_sort_by(ranges, proc(x, y: Range) -> bool { return x[0] < y[0] })
	merged := make([dynamic]Range, context.temp_allocator)
	for r in ranges {
		if n := len(merged); n > 0 && merged[n - 1][1] + 1 >= r[0] {
			merged[n - 1][1] = max(merged[n - 1][1], r[1])
		} else {
			append(&merged, r)
		}
	}
	fmt.sbprintf(b, "@(rodata)\n%s := [?][2]rune{{\n", name)
	line := strings.builder_make(context.temp_allocator)
	strings.write_byte(&line, '\t')
	for r in merged {
		item := fmt.tprintf("{{0x%X, 0x%X}}, ", u32(r[0]), u32(r[1]))
		if strings.builder_len(line) + len(item) > EMOJI_DATA_LINE {
			fmt.sbprintln(b, strings.trim_right_space(strings.to_string(line)))
			strings.builder_reset(&line)
			strings.write_byte(&line, '\t')
		}
		strings.write_string(&line, item)
	}
	fmt.sbprintln(b, strings.trim_right_space(strings.to_string(line)))
	strings.write_string(b, "}\n")
}

gen_emoji_data :: proc(root, data: string) -> string {
	text, ok := read_text(data)
	if !ok { return fmt.tprintf("%s cannot be read (tools/tk fetch_emoji -unicode fetches it)", data) }
	d := emoji_data_source(text)
	out := join({root, EMOJI_DATA_SOURCE})
	if os.write_entire_file(out, d.source) != nil { return fmt.tprintf("%s cannot be written", out) }
	fmt.printfln("%s: Unicode %s, %d + %d ranges (before merging)", EMOJI_DATA_SOURCE, d.version, d.emoji, d.presentation)
	return ""
}

// The board: every step-th fully qualified emoji of emoji-test.txt, and these, known to be hard: a rainbow flag, a family ZWJ
// sequence, a skin tone in a ZWJ sequence, a keycap, a regional flag, a tag sequence, a heart on fire.
@(rodata) BOARD_HARD := [?]string {
	"1F3F3 FE0F 200D 1F308", "1F468 200D 1F469 200D 1F467 200D 1F466", "1F9D1 1F3FD 200D 1F680", "0031 FE0F 20E3", "1F1EB 1F1F7",
	"1F3F4 E0067 E0062 E0065 E006E E0067 E007F", "2764 FE0F 200D 1F525",
}
BOARD_SIZE :: 32
BOARD_SCALE :: 1.0
BOARD_STEP :: 37
BOARD_COLUMNS :: 12
// A cell: 9/5 by 8/5 of the size, on 4 pixels.
BOARD_CELL_WIDE :: 9
BOARD_CELL_HIGH :: 8
BOARD_CELL_PER :: 5
BOARD_CELL_ALIGN :: 4
EDGE_EXE :: `C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe`
// Edge's own clock for the page, and how long it may take.
EDGE_VIRTUAL_TIME_MS :: 4000
EDGE_WAIT_MS :: 60_000

Board_Options :: struct {
	size:    int,      // pixels
	scale:   f64,      // the device scale
	step:    int,
	font:    string,   // "": the pinned Noto Color Emoji (fetched)
	out_dir: string,   // "": build/board_<size>_<scale>
}

// The sequences of the board: every step-th fully qualified one of emoji-test.txt, then BOARD_HARD.
board_list :: proc(emoji_test: string, step: int) -> []string {
	tests := make([dynamic]string, context.temp_allocator)
	for line in strings.split_lines(emoji_test, context.temp_allocator) {
		if len(line) == 0 || strings.index_byte("0123456789abcdefABCDEF", line[0]) < 0 || !strings.contains(line, "; fully-qualified") { continue }
		append(&tests, line)
	}
	list := make([dynamic]string, context.temp_allocator)
	for i := 0; i < len(tests); i += step {
		semi := strings.index_byte(tests[i], ';')
		append(&list, strings.trim_space(tests[i][:semi]))
	}
	append(&list, ..BOARD_HARD[:])
	return list[:]
}

// A cell of the board for emoji of `size` pixels: 9/5 by 8/5 of it, rounded, then up to a multiple of 4.
board_cell :: proc(size: int) -> (w, h: int) {
	nearest :: proc(n, per: int) -> int { return (2 * n + per) / (2 * per) }
	align :: proc(n: int) -> int { return (n + BOARD_CELL_ALIGN - 1) & ~int(BOARD_CELL_ALIGN - 1) }
	return align(nearest(size * BOARD_CELL_WIDE, BOARD_CELL_PER)), align(nearest(size * BOARD_CELL_HIGH, BOARD_CELL_PER))
}

// A number as the shortest text that reads back as it (1, 1.5).
number_text :: proc(f: f64) -> string {
	buf: [64]byte
	return strings.clone(strings.trim_prefix(strconv.write_float(buf[:], f, 'g', -1, 64), "+"), context.temp_allocator)
}

// Runs in the checkout: has tools/colrboard draw the board, a headless Edge draw the same page, colrboard compare the two.
emoji_board :: proc(root: string, o: Board_Options) -> string {
	if os.set_working_directory(root) != nil { return fmt.tprintf("cannot work in %s", root) }
	font := o.font
	if font == "" {
		if why := fetch_emoji({dest = join({root, EMOJI_DEST}), unicode = true, quiet = true}); why != "" { return why }
		font = join({root, EMOJI_DEST, EMOJI_RESULT.name})
	}
	out_dir := o.out_dir != "" ? o.out_dir : fmt.tprintf("build/board_%d_%s", o.size, number_text(o.scale))
	_ = os.make_directory_all(out_dir)
	tests_file := join({filepath.dir(font), "emoji-test.txt"})
	tests, ok := read_text(tests_file)
	if !ok { return fmt.tprintf("%s cannot be read", tests_file) }
	list := board_list(tests, o.step)
	list_file := join({out_dir, "list.txt"})
	listed := strings.builder_make(context.temp_allocator)
	for l in list { fmt.sbprintf(&listed, "%s\r\n", l) }
	if os.write_entire_file(list_file, strings.to_string(listed)) != nil { return fmt.tprintf("%s cannot be written", list_file) }

	_ = os.make_directory_all("build")
	if !run({"odin", "build", "tools/colrboard", "-vet", "-out:build/colrboard.exe"}) { return "build failed" }
	colrboard := join({root, "build", "colrboard.exe"})
	size, scale := fmt.tprint(o.size), number_text(o.scale)
	_ = run({colrboard, "write", font, list_file, out_dir, size, scale})

	cw, ch := board_cell(o.size)
	rows := (len(list) + BOARD_COLUMNS - 1) / BOARD_COLUMNS
	png := join({out_dir, "edge.png"})
	_ = os.remove(png)
	png_abs, _ := os.get_absolute_path(png, context.temp_allocator)
	html_abs, _ := os.get_absolute_path(join({out_dir, "board.html"}), context.temp_allocator)
	html, _ := strings.replace_all(html_abs, "\\", "/", context.temp_allocator)
	profile := join({temp_folder(), fmt.tprintf("board-edge-%d", os.get_pid())})
	edge := []string {
		EDGE_EXE, "--headless=new", "--disable-gpu", "--hide-scrollbars", "--no-first-run", "--disable-extensions",
		fmt.tprintf("--user-data-dir=%s", profile), "--allow-file-access-from-files", fmt.tprintf("--force-device-scale-factor=%s", scale),
		fmt.tprintf("--window-size=%d,%d", BOARD_COLUMNS * cw, rows * ch), fmt.tprintf("--virtual-time-budget=%d", EDGE_VIRTUAL_TIME_MS),
		fmt.tprintf("--screenshot=%s", png_abs), fmt.tprintf("file:///%s", html),
	}
	p, err := os.process_start({command = edge})   // (no output: it is a background program's)
	if err != nil { return fmt.tprintf("%s cannot start", EDGE_EXE) }
	st, werr := os.process_wait(p, EDGE_WAIT_MS * time.Millisecond)
	if werr != nil || !st.exited {
		_ = os.process_kill(p)
		_, _ = os.process_wait(p)
		return "edge timed out"
	}
	if !os.exists(png) { return "no screenshot" }
	if !run({colrboard, "compare", font, list_file, png, out_dir, size, scale}) { return "colrboard compare failed" }
	return ""
}
